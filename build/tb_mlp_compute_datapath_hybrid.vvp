TD_tb_mlp_compute_datapath.sweep_neuron_random ;
    %vpi_call/w 3 116 "$display", "\012=== Random Neuron Configurations ===" {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v000001a665fad3f0_0, 0, 32;
T_0.0 ;
    %load/vec4 v000001a665fad3f0_0;
    %load/vec4 v000001a665facbd0_0;
    %cmp/s;
    %jmp/0xz T_0.1, 5;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v000001a665fae110_0, 0, 32;
T_0.2 ;
    %load/vec4 v000001a665fae110_0;
    %cmpi/s 8, 0, 32;
    %jmp/0xz T_0.3, 5;
    %vpi_func 3 121 "$urandom_range" 32, 32'sb00000000000000000000000000000000, 32'sb00000000000000000000000011111111 {0 0 0};
    %pad/u 8;
    %ix/getv/s 4, v000001a665fae110_0;
    %store/vec4a v000001a665fad0d0, 4, 0;
    %vpi_func 3 122 "$urandom_range" 32, 32'sb00000000000000000000000000000000, 32'sb00000000000000000000000011111111 {0 0 0};
    %pad/u 8;
    %ix/getv/s 4, v000001a665fae110_0;
    %store/vec4a v000001a665fadfd0, 4, 0;
    ; show_stmt_assign_vector: Get l-value for compressed += operand
    %load/vec4 v000001a665fae110_0;
    %pushi/vec4 1, 0, 32;
    %add;
    %cast2;
    %store/vec4 v000001a665fae110_0, 0, 32;
    %jmp T_0.2;
T_0.3 ;
    %vpi_func 3 124 "$urandom_range" 32, 32'sb00000000000000000000000000000000, 32'sb00000000000000000000000011111111 {0 0 0};
    %pad/u 8;
    %store/vec4 v000001a665fad8f0_0, 0, 8;
    %wait E_000001a665f8c6e0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001a665fad170_0, 0, 1;
    %wait E_000001a665f8c6e0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001a665fad170_0, 0, 1;
    %wait E_000001a665f8c6e0;
