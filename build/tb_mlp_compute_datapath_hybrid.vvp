T_0.4 ;
    %load/vec4 v000001a665fad7b0_0;
    %cmpi/ne 1, 0, 1;
    %jmp/0xz T_0.5, 6;
    %wait E_000001a665f8bc20;
    %jmp T_0.4;
T_0.5 ;
    %wait E_000001a665f8c6e0;
    %wait E_000001a665f8c6e0;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v000001a665fad710_0, 0, 2;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001a665fadcb0_0, 0, 1;
    %wait E_000001a665f8c6e0;
